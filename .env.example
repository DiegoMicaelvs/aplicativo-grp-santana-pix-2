# Variáveis de Ambiente - Sistema Indique e Ganhe / Grupo Santana Pix
# Copie este arquivo para .env e ajuste os valores.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Local (Docker Compose, acessando do HOST):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kongpix
# Dentro do container o docker-compose sobrescreve para:
#   postgresql://postgres:postgres@db:5432/kongpix
#
# Supabase (Session Pooler - recomendado para Vercel):
# DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# SSL: "true" force, "false" desliga, vazio = detecta automaticamente
# (local/docker = desligado, hosts gerenciados = ligado)
DATABASE_SSL=

# Tamanho máximo do pool de conexões
DATABASE_POOL_MAX=10

# Banco central opcional para validação entre aplicativos (deixe vazio se não usar)
CENTRAL_DATABASE_URL=

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# OBRIGATÓRIO em produção (o boot falha sem ele).
# Gere um valor aleatório seguro:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-seguro

# Senha master para operações críticas. OBRIGATÓRIO em produção.
MASTER_PASSWORD=troque-por-uma-senha-forte

# Senha exigida para exclusão definitiva de usuários
DEVELOPER_MASTER_PASSWORD=

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Quantos proxies existem NA FRENTE da aplicação. Isso define de onde `req.ip`
# é lido e, portanto, se o rate limiting pode ser burlado.
#   vazio/false = aplicação exposta direto (padrão, mais seguro)
#   1           = atrás de 1 proxy (Vercel, nginx, Cloudflare)
#   N           = N proxies encadeados
# Ligar isso sem um proxy real na frente deixa `req.ip` sob controle do cliente.
TRUST_PROXY=

# Cookie de sessão apenas via HTTPS. Padrão: true quando NODE_ENV=production.
# Só use false se realmente servir produção sob HTTP.
COOKIE_SECURE=

# Origens externas autorizadas a chamar a API com credenciais, separadas por
# vírgula. Vazio = nenhuma (client e API são servidos pelo mesmo processo).
# Ex.: CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting — ATENÇÃO EM EVENTO PRESENCIAL
# ---------------------------------------------------------------------------
# Num evento (SEBRAE, feira, treinamento) centenas de pessoas usam o MESMO WiFi
# e chegam com o MESMO IP público. Qualquer teto por IP derruba o cadastro do
# evento inteiro. Use 0 para desligar os limites por IP nesses dias.
#
# O limite POR CONTA continua ativo e é ele que protege contra força bruta
# num usuário específico — não desligue esse.
LOGIN_MAX_PER_IP=300
LOGIN_MAX_PER_ACCOUNT=10
REGISTER_MAX_PER_IP=500

# Rotas públicas (dashboard da empresa por token), por minuto e por IP.
PUBLIC_MAX_PER_MINUTE=60

# Os contadores ficam na tabela `rate_limits` do Postgres, não em memória:
# sobrevivem a restart e são compartilhados entre instâncias. Para destravar
# alguém no meio do evento:
#   DELETE FROM rate_limits WHERE chave = 'login:user:fulano@exemplo.com';

# ---------------------------------------------------------------------------
# Banco sob carga
# ---------------------------------------------------------------------------
# Conexões simultâneas POR INSTÂNCIA da aplicação. O Postgres tem max_connections
# (padrão 100) compartilhado entre todas. Com 2 instâncias, 25 cada é razoável.
DATABASE_POOL_MAX=25
# Derruba consulta travada em vez de segurar a conexão para sempre
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Docker Compose (usadas apenas na composição dos serviços)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kongpix
POSTGRES_PORT=5433
APP_PORT=5000
ADMINER_PORT=8080
