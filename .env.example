# Variáveis de Ambiente - Sistema Indique e Ganhe Kong Pix
# Copie este arquivo para .env e configure os valores

# Banco de Dados PostgreSQL (Fornecido pelo Replit)
DATABASE_URL=postgresql://user:password@host:port/database

# Ambiente (development ou production)
NODE_ENV=production

# Segredo da Sessão (Gere um valor aleatório seguro)
SESSION_SECRET=gere-um-valor-aleatorio-seguro-aqui

# Senha Master para Operações Críticas
MASTER_PASSWORD=sua-senha-master-segura-aqui

# Configurações Opcionais
PORT=5000
TRUST_PROXY=true