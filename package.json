{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:poll": "cross-env NODE_ENV=development nodemon --legacy-watch --watch server --watch db --watch shared --ext ts,json --exec \"tsx server/index.ts\"",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run tests/integration",
    "db:push": "node scripts/db-push-seguro.mjs",
    "db:seed": "tsx db/seed.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:reset": "docker compose down -v",
    "docker:deps": "docker compose rm -sf app && docker volume rm -f kongpix_node_modules && docker compose up -d --build app",
    "docker:push": "docker compose exec app npm run db:push",
    "docker:seed": "docker compose exec app npm run db:seed",
    "docker:sh": "docker compose exec app sh",
    "build:vercel": "vite build && esbuild server/vercelEntry.ts --platform=node --target=node20 --packages=external --external:./vite --bundle --format=esm --outfile=api/_servidor.js",
    "icons": "node scripts/gerar-favicons.mjs",
    "db:push:bruto": "drizzle-kit push --force --config=./drizzle.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-hover-card": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
